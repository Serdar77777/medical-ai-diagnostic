# Database
DATABASE_URL=sqlite:///./medical_ai.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/medical_ai

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2

# API Keys (optional)
DRUGBANK_API_KEY=your_drugbank_key

# Security
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Environment
ENVIRONMENT=development